# Cloudinary (required for image/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database (optional — defaults to SQLite)
DATABASE_URL=sqlite:///./properties.db

# API server (Town Exchange default: 8024)
API_PORT=8024

# Auth / JWT (required for login/signup — generate a real random value, e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change_me_to_a_random_secret

# ==========================================
# Cashfree Secure ID - Sandbox
# ==========================================
CASHFREE_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
CASHFREE_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification
KYC_MODE=sandbox
KYC_REDIRECT_URL=http://localhost:5188/kyc/callback
KYC_DEV_FALLBACK_DEMO=true
