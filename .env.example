# Cloudinary (required for image/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database (optional — defaults to SQLite)
DATABASE_URL=sqlite:///./properties.db

# Auth (required for login/signup — generate a real random value, e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change_me_to_a_random_secret
